[Unit]
Description=ClassroomAgent private monitoring API
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ClassroomAgent
EnvironmentFile=-/home/ubuntu/ClassroomAgent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/ClassroomAgent/.venv/bin/python /home/ubuntu/ClassroomAgent/api_main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
