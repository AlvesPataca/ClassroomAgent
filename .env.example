TIMEZONE=America/Sao_Paulo
# Relative paths resolve against the project root, not the current directory.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
HTTP_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# SQLite migration v1 -> v2 is additive. Back up the existing DB before first use.
DATABASE_FILE=data/classroom.db
# Attachments always live under data/attachments, relative to this project.
ATTACHMENT_MAX_BYTES=20971520
# Maximum expanded Office archive / PDF stream bytes and extracted text characters.
EXTRACTION_MAX_BYTES=41943040
EXTRACTION_MAX_CHARS=1000000
EXTRACTION_TIMEOUT_SECONDS=30
# Phase 4 context/LLM. Default is offline-safe MockProvider.
CONTEXT_MAX_CHARS=60000
LLM_PROVIDER=mock
# Astra uses the documented OpenAI Responses API. Keep empty until configured.
ASTRA_API_KEY=
ASTRA_BASE_URL=https://api.openai.com/v1
ASTRA_MODEL=gpt-6-astra
# New scope: drive.readonly. Enable Google Drive API in the same OAuth project.
# If token lacks Drive scope: rename GOOGLE_TOKEN_FILE, then python main.py auth.
# Keep credentials.json. Never paste credentials/tokens into logs or attachments.
