TIMEZONE=America/Sao_Paulo
DATABASE_FILE=data/classroom.db
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
INSTITUTION=Universidade Estadual de Goiás
UNIT=Unidade Universitária de Ceres
COURSE_NAME=Sistemas para Internet
STUDENT_NAME=
GENERATED_ROOT=data/generated
DRIVE_RESPONSES_FOLDER_ID=
DRIVE_RESPONSES_FOLDER_NAME=Classroom Agent - Respostas
DRIVE_ORGANIZE_BY_COURSE=true
AUTOMATION_INTERVAL_HOURS=8
LOG_FILE=logs/classroom-agent.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# drive.file is requested by auth; delete token.json and run `python main.py auth` after changing scopes.
# Gemini automatically uses the fallback when the primary model remains overloaded (HTTP 503).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
